# Copy to /etc/adricore-sms/api.env on Ubuntu (install-ubuntu.sh does this).
# systemd EnvironmentFile format: KEY=value  (no export, no quotes unless needed)

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL — required
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=adricore_messaging
DB_USERNAME=adricore
DB_PASSWORD=change-me

# Optional full JDBC URL (overrides host/port/name when set)
# DB_URL=jdbc:postgresql://127.0.0.1:5432/adricore_messaging

APP_PORTAL_URL=https://sms.adricore.co.ug

# Sasula MMBridge (Pay now / payment status)
# SASULA_PAYMENTS_WSDL_URL=https://sasulatest.servicecops.com/sasulauat/MMBridgeWS?wsdl
# SASULA_CHANNEL_CODE=
# SASULA_CHANNEL_PASSWORD=
# SASULA_PAYMENTS_CALLBACK_URL=

# Optional mail (partner signup emails)
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Optional Africa's Talking
# AFRICAS_TALKING_API_KEY=
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_SENDER_ID=Adricore
# AFRICAS_TALKING_ENABLED=true
